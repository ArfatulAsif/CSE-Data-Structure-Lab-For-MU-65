#include <iostream>
using namespace std;

void insertionSort(int a[], int n) {
    for(int i=1; i<n; i++) {
        int key=a[i];
        int j=i-1;

        while (j>=0 && a[j]>key) {
            a[j+1]=a[j];
            j = j-1;
        }
        a[j+1]=key;
    }
}

void printArray(int a[], int size) {
    for(int i=0; i<size; i++)
        cout << a[i] << " ";
    cout << "\n";
}

int main() {
    int a[] = {12, 11, 13, 5, 6};
    int n=sizeof(a) / sizeof(a[0]);

    cout << "Unsorted array: ";
    printArray(a, n);

    insertionSort(a, n);

    cout << "Final sorted array (Insertion Sort): ";
    printArray(a, n);

    return 0;
}

