#include<iostream>
using namespace std;

void bubbleSort(int a[], int n) {
    bool swapped;

    for(int i=0; i<n-1; i++) {
        swapped = false;

        for(int j=0; j<n-i-1; j++) {
            if(a[j] > a[j+1]) {
                swap(a[j], a[j+1]);
                swapped=true;
            }
        }

        if(!swapped)
        break;
    }
}

void printArray(int a[], int size) {
    for (int i=0; i<size; i++)
    cout << a[i]  << " ";
    cout << "\n";
}

int main() {
    int a[]={64, 34, 25, 12, 22, 11, 90};
    int n=sizeof(a) / sizeof(a[0]);


    cout << "Unsorted array: ";
    printArray(a, n);

    bubbleSort(a, n);

    cout << "Sorted array (Bubble Sort): ";
    printArray(a, n);

    return 0;

}
